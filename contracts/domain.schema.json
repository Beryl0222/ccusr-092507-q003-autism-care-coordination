{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "孤独症干预协同档案领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSESSMENT_ACCEPTED",
        "PLAN_APPROVED",
        "GOAL_REPHRASING_PROPOSED",
        "GOAL_RECONSIDERATION_FLAGGED",
        "SERVICE_CLAIMED",
        "SERVICE_RECORDED",
        "OBSERVATION_RECORDED",
        "REFERRAL_ISSUED",
        "RISK_ACTION_TAKEN",
        "RISK_AUTHORIZATION_RECORDED",
        "RISK_INDEPENDENT_REVIEW_RECORDED",
        "SCREENING_FLAG_RAISED",
        "REVIEW_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "child_case",
        "care_plan",
        "service_slot",
        "goal",
        "service_commitment",
        "review_cycle"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "PLAN_APPROVED": [
      "assessment_version",
      "guardian_consent"
    ],
    "GOAL_REPHRASING_PROPOSED": [
      "wording",
      "source_party"
    ],
    "GOAL_RECONSIDERATION_FLAGGED": [
      "goal_ids",
      "trigger_event_id"
    ],
    "SERVICE_CLAIMED": [
      "provider_id",
      "slot_key"
    ],
    "SERVICE_RECORDED": [
      "plan_version",
      "provider_id"
    ],
    "OBSERVATION_RECORDED": [
      "observer_type",
      "observer_id"
    ],
    "REFERRAL_ISSUED": [
      "issue",
      "target_specialty"
    ],
    "RISK_ACTION_TAKEN": [
      "reason",
      "review_due_at"
    ],
    "RISK_AUTHORIZATION_RECORDED": [
      "risk_event_id",
      "guardian_consent"
    ],
    "RISK_INDEPENDENT_REVIEW_RECORDED": [
      "risk_event_id",
      "reviewer_id"
    ],
    "SCREENING_FLAG_RAISED": [
      "instrument",
      "threshold"
    ],
    "REVIEW_COMPLETED": [
      "plan_version_at_review"
    ]
  },
  "payload_field_rules": {
    "assessment_version": "positive_integer",
    "plan_version": "positive_integer",
    "plan_version_at_review": "positive_integer",
    "guardian_consent": "boolean",
    "review_due_at": "timestamp_timezone",
    "goal_ids": "non_empty_string_list"
  },
  "additionalProperties": false
}
